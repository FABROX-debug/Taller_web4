{
  "name": "backendeventos",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "reset-db": "node -e \"require('fs').rmSync('database/eventos.sqlite',{force:true})\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.1",
    "sequelize": "^6.37.7",
    "sqlite3": "^5.1.7"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
